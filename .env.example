# Local dev uses SQLite. For production, switch the datasource provider in
# prisma/schema.prisma to "postgresql" and put your Postgres URL here.
DATABASE_URL="file:./dev.db"

# Signs session cookies. Generate a long random value for any deployed environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"
