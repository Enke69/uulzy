# Postgres connection string. Create a free database at neon.tech or supabase.com.
# Neon example:
#   postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/uulzy?sslmode=require
# Supabase example:
#   postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres
#
# If your provider gives both a POOLED and a DIRECT url, use the pooled one here
# (the app runs serverless), and run `prisma db push` / `db seed` against the
# direct one by prefixing the command, e.g.:
#   DATABASE_URL="<direct url>" npx prisma db push
DATABASE_URL="postgresql://user:password@host:5432/uulzy?sslmode=require"

# Signs session cookies. Generate a long random value for any deployed environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET="change-me"
